{
  "name": "agent-dock",
  "version": "0.1.0",
  "description": "Visual configuration editor for Claude Code agents, skills, commands, rules and MCP servers.",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n ng,electron \"ng serve --port 4200\" \"wait-on http://localhost:4200 && cross-env-shell AGENTDOCK_DEV_URL=http://localhost:4200 electron .\"",
    "electron:start": "npm run build && npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder"
  },
  "build": {
    "appId": "dev.agentdock.app",
    "productName": "AgentDock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/agent-dock/browser/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/aria": "^22.2.7",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}
