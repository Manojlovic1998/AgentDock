{
  "name": "agent-dock",
  "version": "0.1.0-beta.2",
  "description": "Visual configuration editor for Claude Code agents, skills, commands, rules and MCP servers.",
  "main": "dist-electron/main.js",
  "author": "Nemanja Manojlovic",
  "desktopName": "agent-dock.desktop",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:electron": "vitest run -c vitest.electron.config.mts",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently -k -n ng,electron \"ng serve --port 4200\" \"wait-on http://localhost:4200 && cross-env-shell AGENTDOCK_DEV_URL=http://localhost:4200 electron .\"",
    "electron:start": "npm run build && npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "electron:build:win": "npm run build && npm run electron:compile && electron-builder --win --publish never",
    "electron:build:mac": "npm run build && npm run electron:compile && electron-builder --mac --publish never",
    "electron:build:linux": "npm run build && npm run electron:compile && electron-builder --linux --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "dev.agentdock.app",
    "productName": "AgentDock",
    "publish": {
      "provider": "github",
      "owner": "Manojlovic1998",
      "repo": "AgentDock"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/agent-dock/browser/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "NOTICE"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "license": "LICENSE"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    }
  },
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@angular/aria": "^22.2.7",
    "@angular/build": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/cli": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  }
}
